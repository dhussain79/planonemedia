generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/prisma-planone/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPPLIER
  BUYER
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

enum MediaType {
  NEWSPAPER
  MAGAZINE
  TV
  RADIO
  OUTDOOR
  ONLINE
  CINEMA
  OTHER
}

enum CategoryType {
  MEDIA_TYPE
  REGION
  CATEGORY
  PROFILE
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  passwordHash  String?
  role          UserRole  @default(SUPPLIER)
  emailVerified DateTime?
  personId      String?   @unique
  person        Person?   @relation(fields: [personId], references: [id])
  claims        SellerVerification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@id([identifier, token])
  @@map("verification_tokens")
}

model SellerVerification {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  supplierId String
  supplier   Supplier    @relation(fields: [supplierId], references: [id])
  status     ClaimStatus @default(PENDING)
  adminNote  String?
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, supplierId])
  @@map("seller_verifications")
}

model Person {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String?
  jobTitle        String?
  email           String?
  phone           String?
  mobile          String?
  avatar          String?
  isDefault       Boolean   @default(false)
  primaryFor      Supplier[] @relation("PrimaryContact")
  supplierId      String?
  supplier        Supplier? @relation("SupplierContacts", fields: [supplierId], references: [id])
  user            User?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("persons")
}

model Supplier {
  id               String         @id @default(cuid())
  companyName      String
  tradingName      String?
  crn              String?
  vatNumber        String?
  email            String?
  phone            String?
  fax              String?
  billingAddress   String?
  website          String?
  logo             String?
  status           SupplierStatus @default(PENDING_VERIFICATION)
  primaryContact   Person?        @relation("PrimaryContact", fields: [primaryContactId], references: [id])
  primaryContactId String?
  contacts         Person[]       @relation("SupplierContacts")
  media            Media[]
  verifications    SellerVerification[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("suppliers")
}

model Media {
  id            String   @id @default(cuid())
  title         String
  slug          String?
  mediaType     MediaType?
  description   String?
  summary       String?
  region        String?
  category      String?
  profile       String?
  ratecardFiles Json?
  logoUrl       String?
  starRating    Int?
  status        String   @default("published")
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  categories    MediaCategory[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("media")
}

model Category {
  id          String       @id @default(cuid())
  name        String
  type        CategoryType
  parentId    String?
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryHierarchy")
  media       MediaCategory[]

  @@unique([name, type])
  @@map("categories")
}

model MediaCategory {
  mediaId    String
  categoryId String
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([mediaId, categoryId])
  @@map("media_categories")
}

model WaitlistEntry {
  id              String   @id @default(cuid())
  companyName     String   @map("company_name")
  contactPerson   String   @map("contact_person")
  email           String
  phone           String   @map("phone")
  numberOfAssets  Int      @map("number_of_assets")
  preferredCities String   @map("preferred_cities")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("waitlist_entries")
}
