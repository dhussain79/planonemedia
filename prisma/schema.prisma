generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/prisma-planone/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  SUPPLIER
  BUYER
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
}

enum MediaType {
  NEWSPAPER
  MAGAZINE
  TV
  RADIO
  OUTDOOR
  ONLINE
  CINEMA
  OTHER
}

enum PricingModel {
  CPM
  CPC
  FLAT_RATE
  DYNAMIC
}

enum AssetStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ARCHIVED
}

enum CategoryType {
  MEDIA_TYPE
  REGION
  CATEGORY
  PROFILE
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  image         String?
  passwordHash  String?
  role          UserRole  @default(SUPPLIER)
  emailVerified DateTime?
  personId      String?   @unique
  person        Person?   @relation(fields: [personId], references: [id])
  claims        SellerVerification[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@id([identifier, token])
  @@map("verification_tokens")
}

model SellerVerification {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  supplierId String
  supplier   Supplier    @relation(fields: [supplierId], references: [id])
  status     ClaimStatus @default(PENDING)
  adminNote  String?
  decidedBy  String?
  decidedAt  DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([userId, supplierId])
  @@map("seller_verifications")
}

model Person {
  id              String    @id @default(cuid())
  firstName       String
  lastName        String?
  jobTitle        String?
  email           String?
  phone           String?
  mobile          String?
  avatar          String?
  isDefault       Boolean   @default(false)
  primaryFor      Supplier[] @relation("PrimaryContact")
  supplierId      String?
  supplier        Supplier? @relation("SupplierContacts", fields: [supplierId], references: [id])
  user            User?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("persons")
}

model Supplier {
  id               String         @id @default(cuid())
  companyName      String
  tradingName      String?
  crn              String?
  vatNumber        String?
  description      String?
  email            String?
  phone            String?
  fax              String?
  billingAddress   String?
  website          String?
  logo             String?
  status           SupplierStatus @default(PENDING_VERIFICATION)
  primaryContact   Person?        @relation("PrimaryContact", fields: [primaryContactId], references: [id])
  primaryContactId String?
  contacts         Person[]       @relation("SupplierContacts")
  media            Media[]
  verifications    SellerVerification[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("suppliers")
}

model Media {
  id                    String   @id @default(cuid())
  title                 String
  slug                  String?
  mediaType             MediaType?
  description           String?
  summary               String?
  format                String?
  region                String?
  category              String?
  profile               String?
  ratecardFiles         Json?
  logoUrl               String?
  images                Json?
  starRating            Int?
  location              Unsupported("geometry(Point, 4326)")?
  locationAddress       String?
  locationCity          String?
  locationCountry       String?
  locationGovernorate   String?
  locationLat           Float?
  locationLng           Float?
  width                 Float?
  height                Float?
  displayArea           Float?
  resolution            String?
  orientation           String?
  isIlluminated         Boolean  @default(false)
  hasAudio              Boolean  @default(false)
  isInteractive         Boolean  @default(false)
  pricingModel          PricingModel?
  basePrice             Float?
  currency              String?  @default("SAR")
  minimumSpend          Float?
  slotGranularity       String?
  dailyImpressions      Int?
  monthlyImpressions    Int?
  estimatedViews        Int?
  audienceDemographics  Json?
  assetStatus           AssetStatus @default(DRAFT)
  deletedAt             DateTime?
  status                String   @default("published")
  supplierId            String?
  supplier              Supplier? @relation(fields: [supplierId], references: [id])
  categories            MediaCategory[]
  rateCards             RateCard[]
  bookings              Booking[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([slug])
  @@index([mediaType])
  @@index([region])
  @@index([locationCity])
  @@index([assetStatus])
  @@index([deletedAt])
  @@map("media")
}

model Category {
  id          String       @id @default(cuid())
  name        String
  type        CategoryType
  parentId    String?
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[]   @relation("CategoryHierarchy")
  media       MediaCategory[]

  @@unique([name, type])
  @@map("categories")
}

model MediaCategory {
  mediaId    String
  categoryId String
  media      Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([mediaId, categoryId])
  @@map("media_categories")
}

enum DiscountType {
  PERCENTAGE
  FLAT_AMOUNT
}

enum BookingStatus {
  DRAFT
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

model RateCard {
  id              String      @id @default(cuid())
  name            String
  mediaId         String
  supplierId      String?
  isActive        Boolean     @default(true)
  validFrom       DateTime
  validTo         DateTime?
  priority        Int         @default(0)
  pricingModel    PricingModel?
  baseRate        Float
  currency        String      @default("SAR")
  volumeDiscounts Json?
  media           Media       @relation(fields: [mediaId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([mediaId])
  @@index([isActive, validFrom, validTo])
  @@map("rate_cards")
}

model PromoCode {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  isActive      Boolean      @default(true)
  validFrom     DateTime
  validTo       DateTime?
  usageLimit    Int          @default(0)
  usedCount     Int          @default(0)
  perUserLimit  Int          @default(1)
  minSpend      Float        @default(0)
  discountType  DiscountType
  discountValue Float
  maxDiscount   Float?
  assetTypes    Json?
  sellerIds     Json?
  createdBy     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([code, isActive])
  @@map("promo_codes")
}

model Booking {
  id          String        @id @default(cuid())
  mediaId     String
  buyerId     String
  supplierId  String?
  startDate   DateTime
  endDate     DateTime
  quantity    Int           @default(1)
  status      BookingStatus @default(DRAFT)
  totalAmount Float?
  currency    String        @default("SAR")
  media       Media         @relation(fields: [mediaId], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([mediaId, startDate, endDate])
  @@index([status])
  @@map("bookings")
}

model WaitlistEntry {
  id              String   @id @default(cuid())
  companyName     String   @map("company_name")
  contactPerson   String   @map("contact_person")
  email           String
  phone           String   @map("phone")
  numberOfAssets  Int      @map("number_of_assets")
  preferredCities String   @map("preferred_cities")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("waitlist_entries")
}
