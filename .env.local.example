# ──────────────────────────────────────────────
# Required (must set before Vercel deploy)
# ──────────────────────────────────────────────

# Database (Neon PostgreSQL) — replace with your connection string
DATABASE_URL=

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# NextAuth — set to your production URL after deploy (e.g. https://planonemedia.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Recommended (needed once you enable the service)
# ──────────────────────────────────────────────

# PostHog (Product Analytics) — get from app.posthog.com → Project Settings → API Keys
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Meilisearch (Full-text Search) — self-hosted or Cloud
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=

# Mapbox (Interactive Maps) — get from account.mapbox.com → Access tokens
NEXT_PUBLIC_MAPBOX_TOKEN=

# Resend (Transactional Email) — get from resend.com → API Keys
RESEND_API_KEY=

# Sentry (Error Tracking) — get from sentry.io → Project → Client Keys DSN
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Cloudflare R2 (Media File Storage) — get from Cloudflare Dashboard → R2
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=planonemedia
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Upstash Redis (Caching / Rate Limiting) — get from upstash.com
REDIS_URL=

# ──────────────────────────────────────────────
# Optional (add only when needed)
# ──────────────────────────────────────────────

# OpenAI / Anthropic (if you integrate AI features)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# LiveKit (if you add video/meeting features)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=
